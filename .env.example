# Copy to .env and fill in. NEVER commit .env.
# Only PUBLIC_* variables are embedded in the browser bundle.
# The publishable/anon key is designed to be public: security is enforced
# by Row Level Security in the database (supabase/migrations).

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...) or legacy anon key
PUBLIC_SUPABASE_ANON_KEY=

# Leave both empty to run in device-only demo mode (data stays in this browser).

# --- Server-side only (backups / admin scripts). Never prefix with PUBLIC_ ---
# Postgres connection string from Supabase → Project Settings → Database
SUPABASE_DB_URL=
