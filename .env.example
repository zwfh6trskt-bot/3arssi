# Copy to .env and fill in. NEVER commit .env.
# Only PUBLIC_* variables are embedded in the browser bundle. They are public
# by design: access control is enforced in Postgres (GRANTs + Row Level Security).

# --- Hosted database: Neon (used by the live site) ---
# Neon Console → project → Auth → "Auth URL"
PUBLIC_NEON_AUTH_URL=
# Neon Console → project → Data API → "API URL" (ends with /rest/v1)
PUBLIC_NEON_DATA_API_URL=

# --- Alternative: Supabase (leave the Neon values empty to use it) ---
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Leave all of the above empty to run in device-only demo mode.

# Sub-path when served from a folder, e.g. /3arssi for GitHub Pages
PUBLIC_BASE_PATH=

# --- Server-side only (backups). Never prefix with PUBLIC_ ---
# Neon Console → Connect → connection string (owner role)
DATABASE_URL=
